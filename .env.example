# ───────────────────────────────────────────────────────────────────────────
# UZ Temiryo'l backend — muhit o'zgaruvchilari namunasi.
# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)
# Production'da har bir qiymatni to'ldiring.
# ───────────────────────────────────────────────────────────────────────────

# --- Django asosiy ---
DJANGO_DEBUG=True
# Production: yangi maxfiy kalit generatsiya qiling
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_LOG_LEVEL=INFO

# --- Ma'lumotlar bazasi ---
# Lokal ishlab chiqishda bo'sh qoldirsangiz sqlite ishlatiladi.
# Production (PostgreSQL):
#   DATABASE_URL=postgres://uzuser:STRONG_PASSWORD@localhost:5432/uztemiryol
DATABASE_URL=postgres://uzuser:uzpass@localhost:5432/uztemiryol
DB_CONN_MAX_AGE=600

# --- Real-time (WebSocket / Channels) ---
# Bo'sh: bitta-workerli uchun xotira (in-memory) channel layer ishlatiladi.
# Ko'p-workerli production uchun Redis bering:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- JWT (kod-asosli sessiya) ---
JWT_ACCESS_HOURS=12
JWT_ISSUER=uz-temiryol
# Bo'sh bo'lsa DJANGO_SECRET_KEY ishlatiladi
JWT_SIGNING_KEY=

# --- CORS (Next.js frontend manzili) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# --- HTTPS proxy orqasida (production) ---
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
